# Copy to .env. Loaded by the Node service, never Vite client variables.
# Generate once with openssl rand -hex 32; keep stable with the persistent database.
CONFIG_ENCRYPTION_KEY=
ADMIN_USERNAME=admin
# Required: 12+ characters. Bootstrap only; changing this does not reset an existing user.
ADMIN_PASSWORD=
DEMO_MODE=true
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3001
DATA_DIR=.screening-data
# Production: NODE_ENV=production (pnpm start sets this), HTTPS APP_ORIGIN,
# durable private DATA_DIR, strong credentials, DEMO_MODE=false after live smoke.
# Model API keys belong in authenticated admin settings, not VITE_* variables.
